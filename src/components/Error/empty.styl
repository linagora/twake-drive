// Empty states of Twake Space (Figma "TwakeSpace", empty states)
.empty
    display flex
    flex-direction column
    align-items center
    justify-content center
    flex 1 0 auto
    align-self center
    gap 2.5rem
    box-sizing border-box
    width 100%
    padding 2rem 1rem
    text-align center

.empty-title
    line-height 2rem
