@require 'settings/breakpoints'

// doubled selector: must win over cozy-ui's c-empty-img height whatever the stylesheet order
.spaceIllustration.spaceIllustration
    height 100px

.empty
    +medium-screen('min')
        border 2px dashed var(--borderMainColor)
        border-radius 1rem
        margin-bottom 1.5rem
        width 100%
        max-width calc(100% - 7rem)
