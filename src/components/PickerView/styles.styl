.pickerViewBreadcrumb-previousPath
    background none
    border 0
    color var(--actionColorActive)
    font inherit
    padding 0

.pickerViewBreadcrumb-icon
    color var(--actionColorActive)

.pickerViewGridItem
    color inherit
    font inherit

    &:focus-visible
        outline 2px solid var(--actionColorActive)
        outline-offset -2px

.pickerViewSelectionContainer
    user-select none

    &:focus
        outline 0
