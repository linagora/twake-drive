// On a small screen the panel takes the place of the document
.scribe-panel
    position relative
    flex 0 0 26rem
    max-width 100%
    border-left 1px solid var(--dividerColor)
    background-color var(--paperBackgroundColor)

// Over the frame, in the empty end of the first row of the assistant
.scribe-close
    position absolute
    top .5rem
    right .5rem
    z-index 2
