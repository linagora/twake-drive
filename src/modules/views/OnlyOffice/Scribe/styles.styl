// The panel measures the whole distance the handle drags from the right edge
// of the window: the air around the card is padding, never margin
.scribe-panel
    box-sizing border-box
    padding 12px 12px 12px 0
    background-color rgba(20, 20, 45, .055)

.scribe-panel--dark
    background-color rgba(0, 0, 0, .38)

.scribe-panel-card
    min-width 0
    border-radius 14px
    background-color var(--paperBackgroundColor)
    box-shadow 0 2px 4px rgba(20, 20, 45, .10), 0 14px 34px rgba(20, 20, 45, .16)

    .scribe-panel--dark &
        box-shadow 0 2px 4px rgba(0, 0, 0, .55), 0 16px 40px rgba(0, 0, 0, .55)

// The whole gutter between the editor and the card is the grab area; the
// grip shows on hover
.scribe-resize-handle
    width 12px
    cursor col-resize
    touch-action none

    &::after
        content ''
        width 3px
        height 32%
        border-radius 2px
        background-color var(--primaryColor)
        opacity 0
        transition opacity 150ms ease

    &:hover::after
        opacity .4

.scribe-resize-handle--dragging::after
    opacity .8

// Over the full screen dialog that holds the editor
.scribe-selection-button
    z-index 100000
    opacity .75
    transition opacity 200ms

    &:hover
    &:focus-within
        opacity 1

// Over the full screen dialog that holds the editor
.scribe-floating-button
    z-index 100000
    opacity .4
    transition opacity 200ms

    &:hover
    &:focus-within
        opacity 1

    // Over the styles that ButtonBase injects after this sheet
    button
        box-sizing border-box
        width 48px
        padding 5px 2px
        border-radius 20px
        background-color var(--paperBackgroundColor)
        box-shadow var(--shadow2)

// Without geometry: the editor draws no chrome of its own in this corner
.scribe-floating-button--corner
    right 40px
    bottom 80px

// The mark is a square of 334 px centred at (585, 387) on a canvas of
// 1200 x 900: the canvas is drawn at 22/334, the slot shows the mark alone
.scribe-floating-button-slot
    width 44px
    height 33px

.scribe-floating-button-mark
    top -9px
    left -17px
    width 79px
    height 59px
