// The panel measures the whole distance the handle drags from the right edge
// of the window: the air around the card is padding, never margin
.scribe-panel
    box-sizing border-box
    padding 12px 12px 12px 0
    background-color rgba(20, 20, 45, .055)

.scribe-panel--dark
    background-color rgba(0, 0, 0, .38)

.scribe-panel-card
    min-width 0
    border-radius 14px
    background-color var(--paperBackgroundColor)
    box-shadow 0 2px 4px rgba(20, 20, 45, .10), 0 14px 34px rgba(20, 20, 45, .16)

    .scribe-panel--dark &
        box-shadow 0 2px 4px rgba(0, 0, 0, .55), 0 16px 40px rgba(0, 0, 0, .55)

// A basis of 0 gives the intent, which is 100% high, a definite height under
// the notice
.scribe-panel-intent
    flex 1 1 0
    min-height 0

// The whole gutter between the editor and the card is the grab area; the
// grip shows on hover
.scribe-resize-handle
    width 12px
    cursor col-resize
    touch-action none

    &::after
        content ''
        width 3px
        height 32%
        border-radius 2px
        background-color var(--primaryColor)
        opacity 0
        transition opacity 150ms ease

    &:hover::after
        opacity .4

    // The grip stands for the outline
    &:focus-visible
        outline 0

        &::after
            opacity .8

.scribe-resize-handle--dragging::after
    opacity .8

// Over the full screen dialog that holds the editor, under the popover; the
// clicks go through it to the document
.scribe-popover-veil
    top 0
    right 0
    bottom 0
    left 0
    z-index 100000
    background-color rgba(0, 0, 0, .24)
    pointer-events none

.scribe-popover
    z-index 100001

    // Nested: over the styles that Paper injects after this sheet
    .scribe-popover-paper
        width 380px
        border-radius 14px
        overflow hidden

// cozy-interapp gives the element of the intent the height the compact
// scribe reports: the body follows it, and scrolls beyond its maximum
.scribe-popover-body
    min-height 120px
    max-height unquote('min(500px, 70vh)')
    overflow-y auto

// Popper.js sets its left, and the placement on the popper
.scribe-popover-arrow
    position absolute
    width 12px
    height 12px
    background-color var(--paperBackgroundColor)
    transform rotate(45deg)

    .scribe-popover[x-placement^='bottom'] &
        top -6px

    .scribe-popover[x-placement^='top'] &
        bottom -6px

// Nested: over the styles that Drawer injects after this sheet
.scribe-drawer-root .scribe-drawer
    max-height 85vh
    border-radius 12px 12px 0 0

// The whole strip is the grab area of the grip
.scribe-drawer-handle
    flex-shrink 0
    padding 10px 0
    cursor pointer

    &::after
        content ''
        width 32px
        height 4px
        border-radius 2px
        background-color var(--dividerColor)

.scribe-drawer-body
    flex 1 1 auto
    min-height 120px
    overflow-y auto

// Over the full screen dialog that holds the editor
.scribe-selection-button
    z-index 100000
    opacity .75
    transition opacity 200ms

    &:hover
    &:focus-within
        opacity 1

// Over the full screen dialog that holds the editor
.scribe-floating-button
    z-index 100000
    opacity .4
    transition opacity 200ms

    &:hover
    &:focus-within
        opacity 1

    // Over the styles that ButtonBase injects after this sheet
    button
        box-sizing border-box
        width 48px
        padding 5px 2px
        border-radius 20px
        background-color var(--paperBackgroundColor)
        box-shadow var(--shadow2)

// Without geometry: the editor draws no chrome of its own in this corner
.scribe-floating-button--corner
    right 40px
    bottom 80px

// The mark is a square of 334 px centred at (585, 387) on a canvas of
// 1200 x 900: the canvas is drawn at 22/334, the slot shows the mark alone
.scribe-floating-button-slot
    width 44px
    height 33px

.scribe-floating-button-mark
    top -9px
    left -17px
    width 79px
    height 59px
