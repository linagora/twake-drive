@require 'settings/breakpoints'

// cozy-ui gives the content of the layout the whole height, which its
// margins would overflow beside the assistant
.assistant-layout > :first-child
    height auto

// cozy-ui has no utility for this width nor for the background of a paper
.assistant-panel
    flex 0 0 365px
    max-width 100%
    background-color var(--paperBackgroundColor)

    +extra-large-screen('min')
        flex-basis 420px

    +medium-screen()
        border-left 1px solid var(--dividerColor)

    +small-screen()
        flex 1 1 auto
        // Above the keyboard (see useKeyboardSafeHeight)
        max-height var(--assistant-keyboard-safe-height, none)

// A phone has no room for both: the assistant takes the place of the list,
// which stays mounted to keep its state
.assistant-layout--open > :first-child
    +small-screen()
        display none
