.filePickerNavigation
    min-height 2rem

.filePickerNavigationTab
    min-height 2rem
    text-transform none

.filePickerBreadcrumb-previousPath
    background none
    border 0
    color var(--actionColorActive)
    font inherit
    padding 0

.filePickerBreadcrumb-icon
    color var(--actionColorActive)

@supports (display: contents) // @stylint ignore
    .filePickerBreadcrumb-wrapper
        display contents

@supports not (display: contents) // @stylint ignore
    .filePickerBreadcrumb-wrapper
        display flex
        flex 1 1 auto
        align-items center
        width 100%

.verticalDivider
    height 2rem
    display flex
    align-self auto
    align-items center
    margin-left .5rem

.filePickerSelectionContainer
    user-select none

    &:focus
        outline 0

